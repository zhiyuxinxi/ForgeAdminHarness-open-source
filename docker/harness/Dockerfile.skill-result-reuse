# Retain the deployed bounded-release-intent runtime, Host and dependency layers.
# Base sha256:dc94c8669b0a86e6a01cebf566a15d8efc6ebf477d51f2121d96ad62768b466d.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER 0:0
ARG SKILL_BUNDLE_MANIFEST_SHA256
COPY skill-bundle/ /opt/forge-skill-bundles/versions/2026.09.22.6/
COPY --chmod=0644 config/versions.env /usr/local/share/forge-image-build/versions.env
COPY --chmod=0644 docker/harness/Dockerfile.skill-result-reuse docker/harness/Dockerfile.overlay /usr/local/share/forge-image-build/
RUN --network=none node --input-type=module -e '\
  import fs from "node:fs"; import crypto from "node:crypto"; \
  import {validateSkillBundle} from "/usr/local/lib/validate-skill-bundle.mjs"; \
  const root="/opt/forge-skill-bundles/versions/2026.09.22.6"; \
  const digest=(p)=>crypto.createHash("sha256").update(fs.readFileSync(p)).digest("hex"); \
  if(digest(root+"/bundle.manifest.json")!==process.argv[1])throw Error("Skill manifest mismatch"); \
  const manifest=JSON.parse(fs.readFileSync(root+"/bundle.manifest.json")); \
  if(manifest.bundleVersion!=="2026.09.22.6")throw Error("Skill version mismatch"); \
  for(const entry of manifest.files){const p=root+"/"+entry.path;if(fs.statSync(p).size!==entry.bytes||digest(p)!==entry.sha256)throw Error("Skill payload mismatch");} \
  await validateSkillBundle({skillsRoot:root+"/skills",catalogPath:root+"/catalog.json",strict:true}); \
  const current="/opt/forge-skill-bundles/current"; \
  if(fs.lstatSync(current,{throwIfNoEntry:false})){if(!fs.lstatSync(current).isSymbolicLink())throw Error("Skill current is not a symlink");fs.unlinkSync(current);} \
  fs.symlinkSync("versions/2026.09.22.6",current); \
  ' "${SKILL_BUNDLE_MANIFEST_SHA256}"
ENV FORGE_HARNESS_SKILL_BUNDLE_VERSION=2026.09.22.6
LABEL com.forge-delivery.harness-skill-bundle="2026.09.22.6"
LABEL com.forge-delivery.skill-result-reuse.version="2026.09.22.6"
USER 1000:1000

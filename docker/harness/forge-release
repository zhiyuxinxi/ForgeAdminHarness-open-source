#!/usr/bin/env node

const { TextDecoder } = require('node:util');

const CHECKPOINT_PATH_PATTERN = /^[A-Za-z0-9_./@=,+#\[\]-]{1,512}$/u;
const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u;
const CHECKPOINT_IGNORED_PATH_PARTS = new Set([
  '.git', '.forge-cache', 'node_modules', 'target', 'dist', 'build', 'coverage', '.pnpm-store',
]);

const usage = () => {
  process.stdout.write([
    'Usage:',
    '  forge-release contract',
    '  forge-release capability',
    '  forge-release diagnose',
    '  forge-release preflight',
    '  forge-release plan',
    '  forge-release status [--operation-id <UUID>]',
    '  forge-release logs [--services forge-admin,forge-app,forge-flow,forge-ui] [--tail <1..1000>] [--since <1s..24h>]',
    '  forge-release prepare --expected-head <40lowerhex> --expected-fingerprint <64lowerhex> --plan-base64 <base64url-utf8-json>',
    "  forge-release prepare --expected-head <40lowerhex> --expected-fingerprint <64lowerhex> --plan-json '<single-line-json-object>'",
    '  forge-release checkpoint --path <repo-relative-path> [--path <repo-relative-path> ...] --message-base64 <base64url-utf8> --expected-head <40lowerhex> --expected-fingerprint <64lowerhex>',
    '  forge-release integrate --mode start --expected-head <40lowerhex> --expected-fingerprint <64lowerhex> --canonical-head <40lowerhex> [--path <repo-relative-path> ...]',
    '  forge-release integrate --mode continue --operation-id <UUID> --expected-head <40lowerhex> --expected-fingerprint <64lowerhex> --canonical-head <40lowerhex> [--path <repo-relative-path> ...]',
    '  forge-release release [--version <tag>] [--services forge-admin,forge-app,forge-flow,forge-ui] [--approval-ref <text>]',
    '',
    'Only the project-scoped controlled release runner can execute Docker actions.',
    'Workspace docker-compose files, database/cache services, host changes and destructive actions are never accepted.',
    '',
  ].join('\n'));
};

const TASKSPACE_BROKER_URL = 'http://taskspace-broker:3100';
const TASKSPACE_BROKER_URLS = new Set([
  TASKSPACE_BROKER_URL,
  'http://taskspace-broker-stable:3100',
  'http://taskspace-broker-enhanced:3100',
]);
const TASKSPACE_TOKEN_FILE = '/run/forge-taskspace/broker-token';

function resolveTaskspaceTransport(environment = process.env) {
  const taskspaceId = environment.FORGE_TASKSPACE_ID;
  if (typeof taskspaceId === 'string' && taskspaceId.length > 0) {
    const brokerUrlValue = environment.FORGE_TASKSPACE_BROKER_URL || TASKSPACE_BROKER_URL;
    if (!TASKSPACE_BROKER_URLS.has(brokerUrlValue)
      && !/^http:\/\/taskspace-broker-(?:stable|enhanced)-r[1-9][0-9]{0,5}:3100$/u.test(brokerUrlValue)) {
      throw new Error('FORGE_TASKSPACE_BROKER_URL must be an exact trusted TaskSpace Broker origin.');
    }
    const tokenFile = environment.FORGE_TASKSPACE_TOKEN_FILE;
    if (tokenFile !== undefined && tokenFile !== '' && tokenFile !== TASKSPACE_TOKEN_FILE) {
      throw new Error('FORGE_TASKSPACE_TOKEN_FILE must use the protected TaskSpace token path.');
    }
    return {
      brokerUrlValue,
      tokenFile: TASKSPACE_TOKEN_FILE,
    };
  }
  const brokerUrlValue = environment.FORGE_TASKSPACE_BROKER_URL;
  const tokenFile = environment.FORGE_TASKSPACE_TOKEN_FILE;
  if ((brokerUrlValue && !tokenFile) || (!brokerUrlValue && tokenFile)) {
    throw new Error('TaskSpace release requires both FORGE_TASKSPACE_BROKER_URL and FORGE_TASKSPACE_TOKEN_FILE.');
  }
  return { brokerUrlValue, tokenFile };
}

async function parseArguments(argv) {
  const command = argv.shift();
  if (command === 'prepare') {
    const { existsSync } = require('node:fs');
    const path = require('node:path');
    const { pathToFileURL } = require('node:url');
    const policyPath = [path.join(__dirname, 'forge-controlled-command.mjs'),
      path.join(__dirname, '../lib/forge-controlled-command.mjs')].find(value => existsSync(value));
    if (!policyPath) throw new Error('forge-controlled-command.mjs is not installed in a supported location.');
    const { parseControlledReleasePreparationArguments } = await import(pathToFileURL(policyPath).href);
    const parsed = parseControlledReleasePreparationArguments(['forge-release', command, ...argv]);
    if (!parsed) throw new Error("prepare requires exact --expected-head, --expected-fingerprint and exactly one of canonical --plan-base64 or --plan-json '<single-line-json-object>' (UTF-8 object, at most 32 KiB); no other arguments are allowed.");
    return { command, expectedHead: parsed.options['--expected-head'],
      expectedFingerprint: parsed.options['--expected-fingerprint'], probePlan: parsed.probePlan };
  }
  if (command === '--help' && argv.length === 0) {
    usage();
    return null;
  }
  if (!['contract', 'capability', 'diagnose', 'preflight', 'plan', 'status', 'logs', 'release', 'checkpoint', 'integrate'].includes(command)) {
    usage();
    process.exitCode = 2;
    return null;
  }
  if (command === 'logs') {
    const options = {};
    while (argv.length > 0) {
      const option = argv.shift();
      const value = argv.shift();
      if (!['--services', '--tail', '--since'].includes(option)) throw new Error(`Unknown option: ${option}`);
      if (!value) throw new Error(`${option} requires a value.`);
      if (Object.hasOwn(options, option)) throw new Error(`${option} may only be provided once.`);
      options[option] = value;
    }
    const result = { command, tail: 200 };
    if (options['--services'] !== undefined) {
      const services = options['--services'].split(',');
      if (services.length < 1 || services.length > 4 || new Set(services).size !== services.length
        || services.some(service => !['forge-admin', 'forge-app', 'forge-flow', 'forge-ui'].includes(service))) {
        throw new Error('logs --services must name unique project business services.');
      }
      result.services = services;
    }
    if (options['--tail'] !== undefined) {
      if (!/^[1-9][0-9]{0,3}$/u.test(options['--tail']) || Number(options['--tail']) > 1000) {
        throw new Error('logs --tail must be an integer from 1 to 1000.');
      }
      result.tail = Number(options['--tail']);
    }
    if (options['--since'] !== undefined) {
      const duration = /^([1-9][0-9]{0,4})(s|m|h)$/u.exec(options['--since']);
      const seconds = duration ? Number(duration[1]) * ({ s: 1, m: 60, h: 3600 })[duration[2]] : 0;
      if (seconds < 1 || seconds > 86400) throw new Error('logs --since must be a duration from 1s to 24h.');
      result.sinceSeconds = seconds;
    }
    return result;
  }
  if (!['release', 'checkpoint', 'integrate'].includes(command)) {
    if (command === 'status' && argv.length === 2 && argv[0] === '--operation-id' && UUID_PATTERN.test(argv[1])) {
      return { command, operationId: argv[1] };
    }
    if (argv.length > 0) throw new Error(`${command} does not accept options.`);
    return { command };
  }
  if (command === 'checkpoint') {
    const options = {};
    const paths = [];
    while (argv.length > 0) {
      const option = argv.shift();
      const value = argv.shift();
      if (!value) throw new Error(`${option} requires a value.`);
      if (option === '--path') paths.push(value);
      else if (['--message-base64', '--expected-head', '--expected-fingerprint'].includes(option)) {
        if (options[option] !== undefined) throw new Error(`${option} may only be provided once.`);
        options[option] = value;
      } else throw new Error(`Unknown option: ${option}`);
    }
    if (paths.length < 1) {
      throw new Error('checkpoint requires at least one --path value.');
    }
    if (new Set(paths).size !== paths.length) throw new Error('checkpoint --path values must be unique.');
    for (const checkpointPath of paths) {
      const segments = checkpointPath.split('/');
      const testSourcePrefix = /^forge-server\/(?:[^/]+\/)*src\/test\/(?:java|resources)\//u.exec(checkpointPath);
      const testSourceDepth = testSourcePrefix ? testSourcePrefix[0].split('/').length - 1 : Infinity;
      if (!CHECKPOINT_PATH_PATTERN.test(checkpointPath)
        || checkpointPath.startsWith('/')
        || segments.some((segment, index) => segment === ''
          || segment === '.'
          || segment === '..'
          || (CHECKPOINT_IGNORED_PATH_PARTS.has(segment)
            && !(segment === 'coverage' && index >= testSourceDepth && index < segments.length - 1)))) {
        throw new Error(`Invalid checkpoint path: ${checkpointPath}`);
      }
    }
    const encodedMessage = options['--message-base64'];
    if (typeof encodedMessage !== 'string' || !/^[A-Za-z0-9_-]{2,667}$/u.test(encodedMessage)) {
      throw new Error('checkpoint --message-base64 is invalid.');
    }
    const messageBytes = Buffer.from(encodedMessage, 'base64url');
    if (messageBytes.length < 1
      || messageBytes.length > 500
      || messageBytes.toString('base64url') !== encodedMessage) {
      throw new Error('checkpoint --message-base64 is invalid.');
    }
    let message;
    try {
      message = new TextDecoder('utf-8', { fatal: true }).decode(messageBytes);
    } catch {
      throw new Error('checkpoint --message-base64 must contain valid UTF-8.');
    }
    if (!Buffer.from(message, 'utf8').equals(messageBytes) || /[\p{Cc}]/u.test(message)) {
      throw new Error('checkpoint message contains forbidden control characters.');
    }
    if (!/^[0-9a-f]{40}$/u.test(options['--expected-head'] ?? '')) {
      throw new Error('checkpoint --expected-head is invalid.');
    }
    if (!/^[0-9a-f]{64}$/u.test(options['--expected-fingerprint'] ?? '')) {
      throw new Error('checkpoint --expected-fingerprint is invalid.');
    }
    return {
      command,
      paths,
      message,
      expectedHead: options['--expected-head'],
      expectedWorkspaceFingerprint: options['--expected-fingerprint'],
    };
  }
  if (command === 'integrate') {
    const options = {};
    const paths = [];
    while (argv.length > 0) {
      const option = argv.shift();
      const value = argv.shift();
      if (!value) throw new Error(`${option} requires a value.`);
      if (option === '--path') paths.push(value);
      else if (['--mode', '--expected-head', '--expected-fingerprint', '--canonical-head', '--operation-id'].includes(option)) {
        if (options[option] !== undefined) throw new Error(`${option} may only be provided once.`);
        options[option] = value;
      } else throw new Error(`Unknown option: ${option}`);
    }
    const mode = options['--mode'];
    if (!['start', 'continue'].includes(mode)) {
      throw new Error('integrate --mode must be start or continue.');
    }
    if (new Set(paths).size !== paths.length) throw new Error('integrate --path values must be unique.');
    for (const integratePath of paths) {
      const segments = integratePath.split('/');
      const testSourcePrefix = /^forge-server\/(?:[^/]+\/)*src\/test\/(?:java|resources)\//u.exec(integratePath);
      const testSourceDepth = testSourcePrefix ? testSourcePrefix[0].split('/').length - 1 : Infinity;
      if (!CHECKPOINT_PATH_PATTERN.test(integratePath)
        || integratePath.startsWith('/')
        || segments.some((segment, index) => segment === ''
          || segment === '.'
          || segment === '..'
          || (CHECKPOINT_IGNORED_PATH_PARTS.has(segment)
            && !(segment === 'coverage' && index >= testSourceDepth && index < segments.length - 1)))) {
        throw new Error(`Invalid integrate path: ${integratePath}`);
      }
    }
    if (!/^[0-9a-f]{40}$/u.test(options['--expected-head'] ?? '')) {
      throw new Error('integrate --expected-head is invalid.');
    }
    if (!/^[0-9a-f]{64}$/u.test(options['--expected-fingerprint'] ?? '')) {
      throw new Error('integrate --expected-fingerprint is invalid.');
    }
    if (!/^[0-9a-f]{40}$/u.test(options['--canonical-head'] ?? '')) {
      throw new Error('integrate --canonical-head is invalid.');
    }
    const operationId = options['--operation-id'];
    if (mode === 'start' && operationId !== undefined) {
      throw new Error('integrate --operation-id is only accepted with --mode continue.');
    }
    if (mode === 'continue' && !UUID_PATTERN.test(operationId ?? '')) {
      throw new Error('integrate --operation-id is required and must be a UUID with --mode continue.');
    }
    return {
      command,
      mode,
      paths,
      expectedHead: options['--expected-head'],
      expectedWorkspaceFingerprint: options['--expected-fingerprint'],
      canonicalHead: options['--canonical-head'],
      ...(operationId === undefined ? {} : { operationId }),
    };
  }
  const result = {
    command,
    approvalRef: 'User requested release in the current Harness conversation.',
  };
  while (argv.length > 0) {
    const option = argv.shift();
    const value = argv.shift();
    if (!value) throw new Error(`${option} requires a value.`);
    if (option === '--version') result.version = value;
    else if (option === '--services') result.services = value.split(',').filter(Boolean);
    else if (option === '--approval-ref') result.approvalRef = value;
    else throw new Error(`Unknown option: ${option}`);
  }
  return result;
}

async function resolveDefaultReleaseServices(sendAction) {
  const response = await sendAction({ action: 'contract' }, 15000);
  const payload = JSON.parse(response.responseBody);
  if (response.statusCode !== 200 || payload.ok !== true) {
    throw new Error('Cannot resolve release services from the current project contract. No release was submitted.');
  }
  const contract = payload.result?.runnerContract ?? payload.result;
  const services = contract?.release?.allowedReleaseServices;
  const reviewedSets = [
    ['forge-admin', 'forge-flow', 'forge-ui'],
    ['forge-admin', 'forge-app', 'forge-flow', 'forge-ui'],
  ];
  if (!Array.isArray(services) || !reviewedSets.some(expected =>
    services.length === expected.length && new Set(services).size === services.length
      && expected.every(service => services.includes(service)))) {
    throw new Error('The project contract has no reviewed release service set. No release was submitted.');
  }
  return [...services];
}

// Observe the already accepted operation; this function never submits a release.
async function observeRelease(accepted, sendAction, {
  now = Date.now, sleep = ms => new Promise(resolve => setTimeout(resolve, ms)),
  progress = () => {}, timeoutMs = 15 * 60 * 1000, intervalMs = 2000,
} = {}) {
  const { operationId, taskId } = accepted;
  const incomplete = (code, message) => ({ ok: false, result: {
    operation: 'release', operationId, taskId, status: 'unknown', terminal: false,
    observerStatus: 'incomplete', errorCode: code, errorSummary: message,
    recommendedAction: `Observe forge-release status --operation-id ${operationId}; do not resubmit release.`,
  } });
  if (!UUID_PATTERN.test(operationId ?? '') || typeof taskId !== 'string' || !taskId) {
    return incomplete('RELEASE_OBSERVATION_IDENTITY_MISSING', 'Accepted release did not include its operation and task identity.');
  }
  const deadline = now() + timeoutMs;
  let previousStage;
  progress({ operationId, taskId, status: 'accepted' });
  while (now() < deadline) {
    let response;
    try {
      const raw = await sendAction({ action: 'status', operationId }, Math.min(15000, deadline - now()));
      response = JSON.parse(raw.responseBody);
      if (raw.statusCode !== 200 || response.ok !== true) {
        return incomplete('RELEASE_OBSERVATION_UNAVAILABLE', 'Exact operation status is unavailable; the server job may still be running.');
      }
    } catch {
      return incomplete('RELEASE_OBSERVATION_DISCONNECTED', 'Observation disconnected; the server job may still be running.');
    }
    const operation = response.result?.release?.operation;
    if (operation?.operationId !== operationId || operation?.taskId !== taskId) {
      return incomplete('RELEASE_OBSERVATION_IDENTITY_MISMATCH', 'Status did not match the originally accepted operation and task.');
    }
    if (['failed', 'interrupted'].includes(operation.status)
      || (operation.status === 'success' && operation.stage === 'complete' && operation.completedAt)) {
      return { ok: operation.status === 'success', result: {
        ...operation, operation: 'release', terminal: true, observerStatus: 'finished',
      } };
    }
    if (!['accepted', 'running'].includes(operation.status)) {
      return incomplete('RELEASE_OBSERVATION_UNCONFIRMED', 'The operation has no confirmed release terminal result.');
    }
    const stage = `${operation.status}:${operation.stage}`;
    if (stage !== previousStage) { progress(operation); previousStage = stage; }
    await sleep(Math.min(intervalMs, Math.max(0, deadline - now())));
  }
  return incomplete('RELEASE_OBSERVATION_TIMEOUT', 'Observation timed out; the server job was not cancelled or resubmitted.');
}

async function main() {
  const parsed = await parseArguments(process.argv.slice(2));
  if (!parsed) return;
  const socketPath = process.env.FORGE_RELEASE_RUNNER_SOCKET ?? '/run/forge-release/runner.sock';
  const http = await import('node:http');
  const fs = await import('node:fs/promises');
  const body = parsed.command === 'capability'
    ? null
    : parsed.command === 'logs'
    ? { action: 'logs', tail: parsed.tail,
        ...(parsed.services === undefined ? {} : { services: parsed.services }),
        ...(parsed.sinceSeconds === undefined ? {} : { sinceSeconds: parsed.sinceSeconds }) }
    : parsed.command === 'prepare'
    ? { action: 'prepare', expectedHead: parsed.expectedHead,
        expectedFingerprint: parsed.expectedFingerprint, probePlan: parsed.probePlan }
    : parsed.command === 'release'
    ? {
        action: 'release',
        services: parsed.services,
        approvalRef: parsed.approvalRef,
        ...(parsed.version ? { version: parsed.version } : {}),
      }
    : parsed.command === 'checkpoint'
    ? {
        action: 'checkpoint',
        paths: parsed.paths,
        message: parsed.message,
        expectedHead: parsed.expectedHead,
        expectedWorkspaceFingerprint: parsed.expectedWorkspaceFingerprint,
      }
    : parsed.command === 'integrate'
    ? {
        action: 'integrate',
        mode: parsed.mode,
        expectedHead: parsed.expectedHead,
        expectedWorkspaceFingerprint: parsed.expectedWorkspaceFingerprint,
        canonicalHead: parsed.canonicalHead,
        paths: parsed.paths,
        ...(parsed.operationId === undefined ? {} : { operationId: parsed.operationId }),
      }
    : { action: parsed.command, ...(parsed.operationId === undefined ? {} : { operationId: parsed.operationId }) };
  const { brokerUrlValue, tokenFile } = resolveTaskspaceTransport();
  if (parsed.command === 'logs' && !brokerUrlValue) body.action = 'runtime-logs';
  // Old clients omit this field and retain synchronous completion. The direct
  // Runner transport also stays synchronous; only Broker owns the operation.
  if (parsed.operationId && !brokerUrlValue && parsed.command === 'status') {
    throw new Error('status --operation-id requires the TaskSpace Broker transport.');
  }
  if (['prepare', 'checkpoint', 'integrate'].includes(parsed.command) && !brokerUrlValue) {
    throw new Error(`${parsed.command} requires the TaskSpace Broker transport.`);
  }
  let brokerUrl;
  let taskspaceToken;
  if (brokerUrlValue) {
    brokerUrl = new URL(brokerUrlValue);
    if (brokerUrl.protocol !== 'http:'
      || brokerUrl.username
      || brokerUrl.password
      || brokerUrl.search
      || brokerUrl.hash
      || !['', '/'].includes(brokerUrl.pathname)) {
      throw new Error('FORGE_TASKSPACE_BROKER_URL must be a credential-free internal HTTP origin.');
    }
    taskspaceToken = (await fs.readFile(tokenFile, 'utf8')).trim();
    if (taskspaceToken.length < 32 || taskspaceToken.length > 256) {
      throw new Error('TaskSpace token file is invalid.');
    }
  }
  const sendAction = (requestBody, timeoutMs) => {
    const payload = requestBody === null ? null : Buffer.from(JSON.stringify(requestBody));
    return new Promise((resolve, reject) => {
    const requestOptions = {
      ...(brokerUrl === undefined
        ? { socketPath }
        : {
            hostname: brokerUrl.hostname,
            port: brokerUrl.port || 80,
          }),
      path: requestBody === null ? '/healthz' : '/v1/actions',
      method: requestBody === null ? 'GET' : 'POST',
      headers: {
        ...(requestBody === null ? {} : {
          'content-type': 'application/json',
          'content-length': payload.length,
        }),
        ...(taskspaceToken === undefined ? {} : {
          'x-forge-taskspace-token': taskspaceToken,
        }),
      },
    };
    const request = http.request(requestOptions, (response) => {
      const chunks = [];
      let responseBytes = 0;
      response.on('data', (chunk) => {
        responseBytes += chunk.length;
        if (responseBytes > 2 * 1024 * 1024) {
          response.destroy(new Error('Release runner response exceeded the client limit.'));
          return;
        }
        chunks.push(chunk);
      });
      response.once('error', reject);
      response.once('end', () => resolve({
        statusCode: response.statusCode ?? 500,
        responseBody: Buffer.concat(chunks).toString('utf8'),
      }));
    });
    if (timeoutMs !== undefined) {
      const timer = setTimeout(() => request.destroy(new Error('Release observation request timed out.')), timeoutMs);
      request.once('close', () => clearTimeout(timer));
    }
    request.once('error', (error) => {
      if (['ENOENT', 'ECONNREFUSED', 'EACCES'].includes(error.code)) {
        reject(new Error(
          `Controlled release is unavailable because the project ${brokerUrl ? 'TaskSpace Broker' : 'capability socket'} is not ready. `
          + 'Do not search for credentials or ask the user for a token; report this as a platform configuration fault.',
        ));
        return;
      }
      reject(error);
    });
    request.end(payload ?? undefined);
    });
  };
  if (parsed.command === 'release' && parsed.services === undefined) {
    body.services = await resolveDefaultReleaseServices(sendAction);
  }
  if (brokerUrl && (parsed.command === 'release' || (parsed.command === 'status' && parsed.operationId))) {
    // Negotiate before the single mutation. Never retry release to discover
    // support: an older Broker may already have accepted the original request.
    const capability = await sendAction(null);
    const supportsTracking = capability.statusCode === 200
      && JSON.parse(capability.responseBody)?.capabilities?.releaseOperationTracking === 1;
    if (parsed.command === 'release' && supportsTracking) body.executionMode = 'background';
    if (parsed.command === 'status' && !supportsTracking) {
      throw new Error('This Broker does not support exact release operation status; observe existing status/diagnose without resubmitting release.');
    }
  }
  // Leave transport headroom for the Runner's bounded 30-second log read.
  const { statusCode, responseBody } = await sendAction(body, parsed.command === 'logs' ? 35000 : undefined);
  let result = JSON.parse(responseBody);
  if (process.env.FORGE_DEVELOPMENT_MODE === 'direct' && parsed.command === 'release'
    && statusCode >= 200 && statusCode < 300 && result.ok === true && result.result?.status === 'accepted') {
    result = await observeRelease(result.result, sendAction, {
      progress: operation => process.stderr.write(`${JSON.stringify({ operationId: operation.operationId,
        status: operation.status, stage: operation.stage })}\n`),
    });
  }
  process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
  if (statusCode < 200 || statusCode >= 300 || !result.ok) process.exitCode = 1;
}

module.exports = { resolveTaskspaceTransport, observeRelease, parseArguments, resolveDefaultReleaseServices };

if (require.main === module) {
  main().catch((error) => {
    process.stderr.write(`forge-release: ${error.message}\n`);
    process.exitCode = 1;
  });
}

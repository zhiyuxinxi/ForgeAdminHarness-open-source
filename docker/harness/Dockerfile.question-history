ARG BASE_IMAGE=forge-delivery/deepseek-harness:0.1.1-rc.2-governance-explain-20260928-1
FROM ${BASE_IMAGE}
USER 0:0
# One bounded delta layer keeps the verified dependency chain below the host's
# overlay mount limit; no downloads or dependency reinstall are necessary.
RUN --mount=type=bind,source=overlay,target=/forge-overlay \
    cp -a /forge-overlay/. / \
    && node /usr/local/lib/forge-question-history-patch.mjs /opt/forge-harness-runtime/node_modules
USER 1000:1000

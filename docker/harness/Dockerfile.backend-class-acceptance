# Retain the verified focused acceptance service and all installed dependency layers.
# Base sha256:63b21b2f7ffead8398124fa4787edacd8ef7a1db7248250c2f7d43abd948e0fe.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER 0:0
ARG SKILL_BUNDLE_MANIFEST_SHA256
ARG HOST_RUNNER_MANIFEST_SHA256
COPY --chmod=0644 docker/harness/forge-protected-acceptance-service.mjs docker/harness/forge-execution-context.mjs docker/harness/forge-task-execution-contract.mjs docker/harness/forge-production-task-grant.mjs docker/harness/host-verification-runner.mjs docker/harness/conversation-manager.mjs /usr/local/lib/
COPY host-runner-bundle/ /opt/forge-host-runner-bundle/
COPY skill-bundle/ /opt/forge-skill-bundles/versions/2026.09.22.5/
COPY --chmod=0644 config/versions.env /usr/local/share/forge-image-build/versions.env
COPY --chmod=0644 docker/harness/Dockerfile.backend-class-acceptance docker/harness/Dockerfile.overlay /usr/local/share/forge-image-build/
RUN --network=none node --check /usr/local/bin/forge-verify && node --input-type=module -e '\
  import fs from "node:fs"; import crypto from "node:crypto"; \
  import {validateSkillBundle} from "/usr/local/lib/validate-skill-bundle.mjs"; \
  const hostRoot="/opt/forge-host-runner-bundle"; \
  const {validateHostRunnerBundle}=await import(hostRoot+"/bin/forge-host-runner-bundle.mjs"); \
  if(crypto.createHash("sha256").update(fs.readFileSync(hostRoot+"/runner.manifest.json")).digest("hex")!==process.argv[2])throw Error("Host manifest mismatch"); \
  const host=await validateHostRunnerBundle(hostRoot,{profileCatalogVersion:"2026.09.03.22"}); \
  if(host.manifest.bundleVersion!=="2026.09.22.5-backend-class-acceptance")throw Error("Host version mismatch"); \
  const root="/opt/forge-skill-bundles/versions/2026.09.22.5"; \
  const digest=(p)=>crypto.createHash("sha256").update(fs.readFileSync(p)).digest("hex"); \
  if(digest(root+"/bundle.manifest.json")!==process.argv[1])throw Error("Skill manifest mismatch"); \
  const manifest=JSON.parse(fs.readFileSync(root+"/bundle.manifest.json")); \
  if(manifest.bundleVersion!=="2026.09.22.5")throw Error("Skill version mismatch"); \
  for(const entry of manifest.files){const p=root+"/"+entry.path;if(fs.statSync(p).size!==entry.bytes||digest(p)!==entry.sha256)throw Error("Skill payload mismatch");} \
  await validateSkillBundle({skillsRoot:root+"/skills",catalogPath:root+"/catalog.json",strict:true}); \
  const current="/opt/forge-skill-bundles/current"; \
  if(fs.lstatSync(current,{throwIfNoEntry:false})){if(!fs.lstatSync(current).isSymbolicLink())throw Error("Skill current is not a symlink");fs.unlinkSync(current);} \
  fs.symlinkSync("versions/2026.09.22.5",current); \
  ' "${SKILL_BUNDLE_MANIFEST_SHA256}" "${HOST_RUNNER_MANIFEST_SHA256}"
ENV FORGE_HARNESS_SKILL_BUNDLE_VERSION=2026.09.22.5
LABEL com.forge-delivery.harness-skill-bundle="2026.09.22.5"
LABEL com.forge-delivery.backend-class-acceptance.version="2026.09.22.5"
USER 1000:1000

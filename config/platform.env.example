# Host-side platform configuration. Copy to config/platform.env on the server.
DELIVERY_ROOT=/srv/forge-delivery
DELIVERY_OWNER=forge
DELIVERY_GROUP=forgeops

# Root-owned source file mounted into each Harness as a Docker secret. The key
# is deliberately kept outside project workspaces, Git repositories and backups.
DEEPSEEK_KEY_FILE=/srv/forge-delivery/secrets/deepseek-api-key
KIMI_KEY_FILE=/srv/forge-delivery/secrets/kimi-api-key
GLM_KEY_FILE=/srv/forge-delivery/secrets/glm-api-key
SHARED_SERVICES_ENV_FILE=/srv/forge-delivery/secrets/shared-services.env

# Public example: loopback by default. Configure a reviewed private interface explicitly.
DEFAULT_BIND_ADDRESS=127.0.0.1

# Department members are treated as trusted operators after joining the
# company VPN. This explicitly enables the Harness configuration/credential
# plane for the exact per-project trusted Host while keeping Host/Origin and
# cross-site checks at the compatibility proxy. Use loopback-only anywhere
# that does not share this reviewed VPN trust model.
HARNESS_PRIVILEGED_API_MODE=trusted-host

# One platform-level authenticated entry lists every registered project. Project
# Harness workers use dynamic TaskSpace ports; projects no longer allocate a
# separate account/Gateway port.
CONVERSATION_GATEWAY_BIND_ADDRESS=${DEFAULT_BIND_ADDRESS}
CONVERSATION_GATEWAY_PORT=13080
# Stable identity of this control plane; choose a distinct name for an isolated
# installation before prepare. Existing control planes are never renamed implicitly.
CONVERSATION_CONTROL_PLANE_COMPOSE_PROJECT_NAME=forge-conversation-control-plane
# Initial account migration source within this installation's project registry.
CONVERSATION_CONTROL_PLANE_CANONICAL_PROJECT=forge-base

# Identity of the retained vpn77 foundation pinned by config/versions.env.
# Its own Skills version and offline repack receipt are distinct from the target.
HARNESS_FOUNDATION_SKILL_BUNDLE_VERSION=2026.09.01.5
HARNESS_FOUNDATION_ASSEMBLY_MODE=offline-repack

# Allocation range used by create-project.sh. Each project consumes one Forge UI port.
UI_PORT_MIN=18080
UI_PORT_MAX=18979

# One platform-level SFTPGo instance exposes per-project upload directories.
# It is deliberately outside each project Compose stack and only mounts its
# own data root, never the projects root, workspaces, Harness state or secrets.
FILE_GATEWAY_BIND_ADDRESS=${DEFAULT_BIND_ADDRESS}
FILE_GATEWAY_HTTP_PORT=14080
FILE_GATEWAY_SFTP_PORT=14022
FILE_GATEWAY_ADMIN_USERNAME=forge-file-admin
FILE_GATEWAY_BOOTSTRAP_USERS=product-upload,business-upload,delivery-upload

# Read-only Web portal for the governed AI delivery playbook. It is a
# platform-level service and must remain on the reviewed company VPN address.
PLAYBOOK_BIND_ADDRESS=${DEFAULT_BIND_ADDRESS}
PLAYBOOK_HTTP_PORT=15080

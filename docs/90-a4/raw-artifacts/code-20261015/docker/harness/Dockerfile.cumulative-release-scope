# Reuse the verified receipt-reuse image and its existing dependency layers.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER 0:0
COPY --chmod=0644 docker/harness/forge-protected-acceptance-service.mjs /usr/local/lib/forge-protected-acceptance-service.mjs
COPY --chmod=0644 docker/harness/Dockerfile.cumulative-release-scope /usr/local/share/forge-image-build/
RUN --network=none node --check /usr/local/lib/forge-protected-acceptance-service.mjs
LABEL com.forge-delivery.cumulative-release-scope.version="2026.09.22.1"
USER 1000:1000

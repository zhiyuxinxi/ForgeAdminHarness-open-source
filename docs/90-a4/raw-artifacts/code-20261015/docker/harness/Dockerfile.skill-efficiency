# Preserve the verified runtime and dependency layers; change only the Skill bundle.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER 0:0
ARG SKILL_BUNDLE_MANIFEST_SHA256
COPY skill-bundle/ /opt/forge-skill-bundles/versions/2026.09.21.1/
COPY --chmod=0644 config/versions.env /usr/local/share/forge-image-build/versions.env
COPY --chmod=0644 docker/harness/Dockerfile.skill-efficiency /usr/local/share/forge-image-build/Dockerfile.skill-efficiency
RUN --network=none node --input-type=module -e '\
  import fs from "node:fs"; import crypto from "node:crypto"; \
  import {validateSkillBundle} from "/usr/local/lib/validate-skill-bundle.mjs"; \
  const root="/opt/forge-skill-bundles/versions/2026.09.21.1"; \
  const bytes=fs.readFileSync(root+"/bundle.manifest.json"); \
  if(!/^[a-f0-9]{64}$/.test(process.argv[1])||crypto.createHash("sha256").update(bytes).digest("hex")!==process.argv[1])throw Error("Skill manifest mismatch"); \
  const manifest=JSON.parse(bytes); \
  if(manifest.bundleVersion!=="2026.09.21.1")throw Error("Skill version mismatch"); \
  for(const entry of manifest.files){const p=root+"/"+entry.path; const b=fs.readFileSync(p);if(b.length!==entry.bytes||crypto.createHash("sha256").update(b).digest("hex")!==entry.sha256)throw Error("Skill payload mismatch");} \
  await validateSkillBundle({skillsRoot:root+"/skills",catalogPath:root+"/catalog.json",strict:true}); \
  const current="/opt/forge-skill-bundles/current"; \
  if(fs.existsSync(current)&&!fs.lstatSync(current).isSymbolicLink())throw Error("Skill current must be a symlink"); \
  if(fs.lstatSync(current,{throwIfNoEntry:false}))fs.unlinkSync(current); \
  fs.symlinkSync("versions/2026.09.21.1",current); \
  ' "${SKILL_BUNDLE_MANIFEST_SHA256}"
ENV FORGE_HARNESS_SKILL_BUNDLE_VERSION=2026.09.21.1
LABEL com.forge-delivery.harness-skill-bundle="2026.09.21.1"
USER 1000:1000

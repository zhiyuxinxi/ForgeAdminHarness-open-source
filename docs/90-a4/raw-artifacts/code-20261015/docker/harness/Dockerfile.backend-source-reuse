# Retain the verified scope fixes, Skills, Host tools and dependency layers.
# Base: sha256:f973adf8f0d1fd12db5547ed2af976fac37c9247e664a2f7471ace392167b992
ARG BASE_IMAGE=forge-delivery/deepseek-harness:0.1.1-rc.2-refactor-negation-scope-20260923-1
FROM ${BASE_IMAGE}
USER 0:0
ARG HOST_RUNNER_MANIFEST_SHA256
COPY --chmod=0644 docker/harness/forge-host-verification-receipt.mjs docker/harness/host-verification-runner.mjs docker/harness/forge-protected-acceptance-service.mjs /usr/local/lib/
COPY host-runner-bundle/ /opt/forge-host-runner-bundle/
COPY --chmod=0644 config/versions.env docker/harness/Dockerfile.backend-source-reuse /usr/local/share/forge-image-build/
RUN --network=none node --input-type=module -e '\
  import fs from "node:fs"; import crypto from "node:crypto"; \
  import {validateHostRunnerBundle} from "/opt/forge-host-runner-bundle/bin/forge-host-runner-bundle.mjs"; \
  const root="/opt/forge-host-runner-bundle"; \
  const sha=p=>crypto.createHash("sha256").update(fs.readFileSync(p)).digest("hex"); \
  if(sha(root+"/runner.manifest.json")!==process.argv[1])throw Error("Host manifest mismatch"); \
  const bundle=await validateHostRunnerBundle(root,{profileCatalogVersion:"2026.09.03.22",nodeMajor:24}); \
  if(bundle.manifest.bundleVersion!=="2026.09.23.2-backend-source-reuse")throw Error("Host version mismatch"); \
  for(const name of ["forge-host-verification-receipt","host-verification-runner"]){ \
    if(sha(root+"/lib/"+name+".mjs")!==sha("/usr/local/lib/"+name+".mjs"))throw Error("Host/image module mismatch: "+name); \
  }' "${HOST_RUNNER_MANIFEST_SHA256}"
LABEL com.forge-delivery.backend-source-reuse.version="2026.09.23.2"
USER 1000:1000

# Retain the verified frontend scope, lint, wakeup, Skills and dependency layers.
# Base: sha256:e50221411fee9d35124551b31bc91c81b86180e3113f99624248f944a2889a30
ARG BASE_IMAGE=forge-delivery/deepseek-harness:0.1.1-rc.2-frontend-negation-scope-20260922-1
FROM ${BASE_IMAGE}
USER 0:0
ARG HOST_RUNNER_MANIFEST_SHA256
COPY --chmod=0644 docker/harness/forge-governance.mjs docker/harness/forge-host-verification-receipt.mjs docker/harness/host-verification-runner.mjs /usr/local/lib/
COPY --chmod=0644 scripts/configure-codex-model-route.py /usr/local/lib/configure-codex-model-route.py
COPY host-runner-bundle/ /opt/forge-host-runner-bundle/
COPY --chmod=0644 config/versions.env docker/harness/Dockerfile.governance-delta /usr/local/share/forge-image-build/
RUN --network=none node --input-type=module -e '\
  import fs from "node:fs"; import crypto from "node:crypto"; \
  import {validateHostRunnerBundle} from "/opt/forge-host-runner-bundle/bin/forge-host-runner-bundle.mjs"; \
  const root="/opt/forge-host-runner-bundle"; \
  const sha=p=>crypto.createHash("sha256").update(fs.readFileSync(p)).digest("hex"); \
  if(sha(root+"/runner.manifest.json")!==process.argv[1])throw Error("Host manifest mismatch"); \
  const bundle=await validateHostRunnerBundle(root,{profileCatalogVersion:"2026.09.03.22",nodeMajor:24}); \
  if(bundle.manifest.bundleVersion!=="2026.09.23.1-governance-delta")throw Error("Host version mismatch"); \
  for(const name of ["forge-governance","forge-host-verification-receipt","host-verification-runner"]){ \
    if(sha(root+"/lib/"+name+".mjs")!==sha("/usr/local/lib/"+name+".mjs"))throw Error("Host/image module mismatch: "+name); \
  }' "${HOST_RUNNER_MANIFEST_SHA256}"
LABEL com.forge-delivery.governance-delta.version="2026.09.23.1"
USER 1000:1000

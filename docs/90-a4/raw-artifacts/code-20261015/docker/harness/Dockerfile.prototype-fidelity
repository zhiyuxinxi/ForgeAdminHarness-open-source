# Retain the verified first prototype-fidelity image, its Host bundle and all dependencies.
ARG BASE_IMAGE=forge-delivery/deepseek-harness:0.1.1-rc.2-prototype-fidelity-20260924-1
FROM ${BASE_IMAGE}
USER 0:0
COPY overlay/ /
RUN test -L /opt/forge-skill-bundles/current \
    && ln -sfn versions/2026.09.24.2 /opt/forge-skill-bundles/current
ENV FORGE_HARNESS_SKILL_BUNDLE_VERSION=2026.09.24.2
LABEL com.forge-delivery.harness-skill-bundle="2026.09.24.2"
LABEL com.forge-delivery.prototype-fidelity.version="2026.09.24.2"
USER 1000:1000

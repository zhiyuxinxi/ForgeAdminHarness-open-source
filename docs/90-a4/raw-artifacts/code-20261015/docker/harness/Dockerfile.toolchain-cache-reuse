# Retain current release-continuation fixes, Skills and installed dependency layers.
# Base: sha256:32f04cc3a53662dcfd280f824497e3cbcbbf88e988f0891aeacd6d04f0b250a0
ARG BASE_IMAGE=forge-delivery/deepseek-harness:0.1.1-rc.2-current-release-continuation-20260923-1
FROM ${BASE_IMAGE}
USER 0:0
ARG HOST_RUNNER_MANIFEST_SHA256
COPY --chmod=0644 docker/harness/host-dependency-seed.mjs docker/harness/forge-host-verification-receipt.mjs docker/harness/host-prepared-dependencies.mjs docker/harness/host-verification-runner.mjs docker/harness/forge-protected-acceptance-service.mjs /usr/local/lib/
COPY host-runner-bundle/ /opt/forge-host-runner-bundle/
COPY --chmod=0644 config/versions.env docker/harness/Dockerfile.toolchain-cache-reuse /usr/local/share/forge-image-build/
RUN --network=none node --input-type=module -e '\
  import fs from "node:fs"; import crypto from "node:crypto"; \
  import {validateHostRunnerBundle} from "/opt/forge-host-runner-bundle/bin/forge-host-runner-bundle.mjs"; \
  const root="/opt/forge-host-runner-bundle"; \
  const sha=p=>crypto.createHash("sha256").update(fs.readFileSync(p)).digest("hex"); \
  if(sha(root+"/runner.manifest.json")!==process.argv[1])throw Error("Host manifest mismatch"); \
  const bundle=await validateHostRunnerBundle(root,{profileCatalogVersion:"2026.09.03.22",nodeMajor:24}); \
  if(bundle.manifest.bundleVersion!=="2026.09.23.3-toolchain-cache-reuse")throw Error("Host version mismatch"); \
  for(const name of ["host-dependency-seed","forge-host-verification-receipt","host-prepared-dependencies","host-verification-runner"]){ \
    if(sha(root+"/lib/"+name+".mjs")!==sha("/usr/local/lib/"+name+".mjs"))throw Error("Host/image module mismatch: "+name); \
  }' "${HOST_RUNNER_MANIFEST_SHA256}"
LABEL com.forge-delivery.toolchain-cache-reuse.version="2026.09.23.3"
USER 1000:1000
